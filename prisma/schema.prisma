generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth.js ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  digestEnabled Boolean   @default(true)
  // テスト用のパスワードログイン（PASSWORD_LOGIN=1 のときのみ）。
  handle        String?   @unique
  passwordHash  String?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  posts       Post[]
  reactions   Reaction[]
  muteRules   MuteRule[]
  circles     Circle[]
  postVeils   PostVeil[]
  circleBans  CircleBan[]
  topicMutes  TopicMute[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  authMethod   String   @default("legacy")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---- fubako ----
model Circle {
  description String @default("")
  id          String   @id @default(cuid())
  name        String
  inviteCode  String   @unique
  invitesEnabled Boolean @default(true)
  memberLimit Int      @default(30)
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  memberships Membership[]
  posts       Post[]
  bans        CircleBan[]
  topicMutes  TopicMute[]
}

model Membership {
  userId     String
  circleId   String
  joinedAt   DateTime  @default(now())
  // 「今日この場に来た人がいるか」だけに使う。本人にも他人にも表示せず API でも返さない。
  lastSeenAt DateTime?
  archivedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle     Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
}

/// 管理者による参加取消。解除されるまで同じアカウントの再参加を止める。
model CircleBan {
  circleId String
  userId String
  createdAt DateTime @default(now())
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
}

enum PostVisibility {
  circle
  private
}

model Post {
  visibility         PostVisibility @default(circle)
  id                 String     @id @default(cuid())
  circleId           String
  authorId           String
  body               String
  tags               String[]   @default([])
  createdAt          DateTime   @default(now())
  expiresAt          DateTime
  deletedAt          DateTime?
  cw                 String?
  afterword          String     @default("")
  clientRequestId    String?
  requestHash        String?
  // ダイジェストで反応を知らせた時刻。同じ反応で二度知らせないための印。
  reactionNotifiedAt DateTime?
  // 投稿の「形」。書き手には選ばせず lib/form.ts が本文と画像から決める。
  form               String     @default("text")
  // 形態素解析で取り出した語。重い順に並ぶ。API では返さない（lib/similar.ts でだけ使う）。
  terms              String[]   @default([])
  images             Image[]
  circle             Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author             User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions          Reaction[]
  veils              PostVeil[]

  @@index([circleId, createdAt])
  @@index([authorId, createdAt])
  @@unique([authorId, clientRequestId])
}

model Reaction {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// 読み手が自分でその投稿だけを伏せた記録。書き手には見せず、どこでも数えない。
/// 語は持たない（語で守るのは MuteRule の役目。ここは「この紙は閉じておく」だけ）。
model PostVeil {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model MuteRule {
  id        String   @id @default(cuid())
  userId    String
  word      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}

model Image {
  id        String   @id @default(cuid())
  postId    String
  key       String   @unique
  blurhash  String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// 見る準備ができるまで、本人が箱ごとに伏せる話題。
model TopicMute {
  id             String @id @default(cuid())
  userId         String
  circleId       String
  word           String
  normalizedWord String
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle         Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, normalizedWord])
}
