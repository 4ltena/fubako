DATABASE_URL=postgresql://...
SHADOW_DATABASE_URL=        # prisma migrate dev 用のシャドーDB。未設定でも通常の migrate deploy には不要
AUTH_SECRET=            # npx auth secret で生成
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
EMAIL_SERVER=           # マジックリンク用SMTP  例: smtp://user:pass@host:587
EMAIL_FROM=
CRON_SECRET=            # ダイジェストcronの認証用
BLOB_READ_WRITE_TOKEN=     # Vercel Blob。未設定ならローカルの .data/images/ に保存する
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=      # Phase 5以降のみ
DEV_LOGIN=              # 1 で未ホストの next dev のみ開発用セッションリンクを許可。本番・プレビューでは常に無効
PASSWORD_LOGIN=         # 1 で未ホストの next dev のみ名前だけのテスト入口を許可。通常認証には使わない
CIRCLE_MEMBER_LIMIT=    # 新しい箱の定員。既定 30。発表など大人数のときだけ上げる（既存の箱には効かない）
