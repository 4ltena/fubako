DATABASE_URL=postgresql://...
AUTH_SECRET=            # npx auth secret で生成
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
EMAIL_SERVER=           # マジックリンク用SMTP  例: smtp://user:pass@host:587
EMAIL_FROM=
CRON_SECRET=            # ダイジェストcronの認証用
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=      # Phase 5以降のみ
DEV_LOGIN=              # 1 にすると本番ビルドでも /api/dev/login が有効になる。本番環境では空のまま
