{
  "name": "fubako",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev -n fubako",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed.mjs",
    "cron": "node scripts/cron.mjs",
    "backfill:terms": "node scripts/backfill-terms.mjs",
    "verify:tokenizer": "node scripts/verify-tokenizer.mjs",
    "contrast": "node scripts/contrast.mjs",
    "warm": "node scripts/keepwarm.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "blurhash": "^2.0.5",
    "dotenv": "^17.4.2",
    "kuromoji": "^0.1.2",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "@prisma/client": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
